{{- /* One template for both layouts: $ddd selects the layout-specific names and blocks. */ -}}
{{- $ddd := eq .Layout "ddd" -}}
{{- $pkg := "handler" -}}{{- if $ddd}}{{$pkg = "http"}}{{end -}}
package {{$pkg}}

import (
	"strconv"

	"github.com/gofiber/fiber/v3"
	"github.com/rahmadafandi/fibr/v2/bind"
	"github.com/rahmadafandi/fibr/v2/response"
{{if $ddd}}	app{{.Pkg}} "{{.Module}}/internal/application/{{.Pkg}}"
	domain "{{.Module}}/internal/domain/{{.Pkg}}"
{{else}}	"{{.Module}}/internal/model"
	"{{.Module}}/internal/service"
{{end}})

// {{.Type}}Handler exposes {{.Pkg}} HTTP routes.
type {{.Type}}Handler struct {
{{if $ddd}}	svc *app{{.Pkg}}.Service
{{else}}	svc *service.{{.Type}}Service
{{end}}}

// New{{.Type}}Handler creates a {{.Type}}Handler.
{{if $ddd}}func New{{.Type}}Handler(svc *app{{.Pkg}}.Service) *{{.Type}}Handler {
{{else}}func New{{.Type}}Handler(svc *service.{{.Type}}Service) *{{.Type}}Handler {
{{end}}	return &{{.Type}}Handler{svc: svc}
}

// RegisterRoutes mounts the {{.Pkg}} routes under /{{.Plural}}.
func (h *{{.Type}}Handler) RegisterRoutes(app fiber.Router) {
	g := app.Group("/{{.Plural}}")
	g.Get("/", h.list)
	g.Get("/:id", h.get)
	g.Post("/", h.create)
}

func (h *{{.Type}}Handler) list(c fiber.Ctx) error {
	items, err := h.svc.List(c.Context())
	if err != nil {
		return response.SendError(c, nil, err.Error(), fiber.StatusInternalServerError)
	}
	return response.SendSuccess(c, items, "ok")
}

func (h *{{.Type}}Handler) get(c fiber.Ctx) error {
	id, err := strconv.ParseInt(c.Params("id"), 10, 64)
	if err != nil {
		return response.SendError(c, nil, "invalid id", fiber.StatusBadRequest)
	}
	e, err := h.svc.Get(c.Context(), id)
	if err != nil {
		return response.SendError(c, nil, err.Error(), fiber.StatusNotFound)
	}
	return response.SendSuccess(c, e, "ok")
}

func (h *{{.Type}}Handler) create(c fiber.Ctx) error {
{{if $ddd}}	e, ok := bind.Body[domain.{{.Type}}](c)
{{else}}	e, ok := bind.Body[model.{{.Type}}](c)
{{end}}	if !ok {
		return nil
	}
	if err := h.svc.Create(c.Context(), &e); err != nil {
		return response.SendError(c, nil, err.Error(), fiber.StatusInternalServerError)
	}
	return response.SendSuccess(c, e, "created", fiber.StatusCreated)
}
