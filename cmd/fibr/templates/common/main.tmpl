{{- /* One template for both layouts: $ddd selects the layout-specific names and blocks. */ -}}
{{- $ddd := eq .Layout "ddd" -}}
{{- $openDB := "fibrdatabase.NewBun" -}}{{- if $ddd}}{{$openDB = "database.New"}}{{end -}}
{{- $router := "router" -}}{{- if $ddd}}{{$router = "httpiface"}}{{end -}}
{{- $handler := "handler" -}}{{- if $ddd}}{{$handler = "httpiface"}}{{end -}}
package main

import (
	"context"
	"fmt"
	"log"

	"github.com/rahmadafandi/fibr/v2/bootstrap"
	fibrdatabase "github.com/rahmadafandi/fibr/v2/database"
	"github.com/rahmadafandi/fibr/v2/health"
	fibrmigrate "github.com/rahmadafandi/fibr/v2/migrate"
	fibropenapi "github.com/rahmadafandi/fibr/v2/openapi"
	"github.com/rahmadafandi/fibr/v2/rediskit"
{{if .I18n}}	fibri18n "github.com/rahmadafandi/fibr/v2/i18n"
	"{{.Module}}/internal/locales"
{{end}}
	"github.com/rahmadafandi/fibr/v2/tracing"
	"github.com/spf13/cobra"
	"github.com/uptrace/bun"
	redislib "github.com/redis/go-redis/v9"
{{if .Auth}}	fibrauth "github.com/rahmadafandi/fibr/v2/auth"
	zlog "github.com/rs/zerolog/log"
{{end}}{{if or .Queue .Mailer}}	"github.com/gofiber/fiber/v3"
{{end}}{{if .Queue}}	fibrjobs "github.com/rahmadafandi/fibr/v2/jobs"
{{if $ddd}}	appjobs "{{.Module}}/internal/application/jobs"
{{else}}	appjobs "{{.Module}}/internal/jobs"
{{end}}{{end}}{{if .Mailer}}	fibrmailer "github.com/rahmadafandi/fibr/v2/mailer"
{{end}}
{{if $ddd}}	"{{.Module}}/internal/infrastructure/config"
	"{{.Module}}/internal/infrastructure/database"
	httpiface "{{.Module}}/internal/interface/http"
{{else}}	"{{.Module}}/internal/config"
{{end}}	"{{.Module}}/internal/migrations"
{{if $ddd}})
{{else}}	"{{.Module}}/internal/router"
{{if or .Sample .Auth .Realtime .I18n}}	"{{.Module}}/internal/handler"
{{end}})
{{end}}
func main() {
	root := &cobra.Command{
		Use:          "{{.Name}}",
		Short:        "{{.Name}} server",
		Long:         "Run without a subcommand (or with \"serve\") to start the HTTP server. Use \"migrate\" for database migrations.",
		SilenceUsage: true,
	}
	root.RunE = func(cmd *cobra.Command, args []string) error { return runServe(false) }
	root.AddCommand(serveCmd())
	root.AddCommand(fibrmigrate.NewCommand(openDB, migrations.Migrations))
{{if .Queue}}	root.AddCommand(workerCmd())
	root.AddCommand(schedulerCmd())
{{end}}	if err := root.Execute(); err != nil {
		log.Fatal(err)
	}
}

func serveCmd() *cobra.Command {
	var autoMigrate bool
	cmd := &cobra.Command{
		Use:   "serve",
		Short: "run the HTTP server",
		RunE:  func(cmd *cobra.Command, args []string) error { return runServe(autoMigrate) },
	}
	cmd.Flags().BoolVar(&autoMigrate, "auto-migrate", false, "create tables at startup (dev)")
	return cmd
}

{{if .Queue}}func workerCmd() *cobra.Command {
	return &cobra.Command{
		Use:   "worker",
		Short: "run the background job worker",
		RunE:  func(cmd *cobra.Command, args []string) error { return runWorker() },
	}
}

func runWorker() error {
	cfg, err := config.Load()
	if err != nil {
		return err
	}
	if cfg.RedisURL == "" {
		return fmt.Errorf("worker requires REDIS_URL")
	}
	opt, err := fibrjobs.RedisConnOpt(cfg.RedisURL)
	if err != nil {
		return err
	}
	srv := fibrjobs.NewServer(opt, fibrjobs.ServerConfig{Concurrency: cfg.QueueConcurrency})
{{if .Mailer}}	base, _ := fibrmailer.New(fibrmailer.SMTPConfig{
		Host:     cfg.SMTPHost,
		Port:     cfg.SMTPPort,
		Username: cfg.SMTPUsername,
		Password: cfg.SMTPPassword,
		From:     cfg.SMTPFrom,
	})
	appjobs.Register(srv, base)
	appjobs.RegisterEmail(srv, base)
{{else}}	appjobs.Register(srv)
{{end}}	log.Println("worker started")
	return srv.Run()
}

func schedulerCmd() *cobra.Command {
	return &cobra.Command{
		Use:   "scheduler",
		Short: "run the periodic job scheduler",
		RunE:  func(cmd *cobra.Command, args []string) error { return runScheduler() },
	}
}

func runScheduler() error {
	cfg, err := config.Load()
	if err != nil {
		return err
	}
	if cfg.RedisURL == "" {
		return fmt.Errorf("scheduler requires REDIS_URL")
	}
	opt, err := fibrjobs.RedisConnOpt(cfg.RedisURL)
	if err != nil {
		return err
	}
	sched := fibrjobs.NewScheduler(opt)
	if err := appjobs.RegisterSchedule(sched); err != nil {
		return err
	}
	log.Println("scheduler started")
	return sched.Run()
}

{{end}}func runServe(autoMigrate bool) error {
	cfg, err := config.Load()
	if err != nil {
		return err
	}
	var dbOpts []fibrdatabase.Option
	if cfg.TracingEnabled {
		dbOpts = append(dbOpts, fibrdatabase.WithTracing())
	}
	db, err := {{$openDB}}(cfg.DatabaseURL, dbOpts...)
	if err != nil {
		return err
	}

	var cleanups []func(context.Context) error
	if cfg.TracingEnabled {
		shutdown, terr := tracing.Setup(context.Background(), tracing.WithServiceName("{{.Name}}"))
		if terr != nil {
			log.Printf("tracing setup failed; continuing without tracing: %v", terr)
		} else {
			cleanups = append(cleanups, shutdown)
		}
	}

{{if .Queue}}	var queueClient *fibrjobs.Client
	var asynqmonMount *bootstrap.AsynqmonMount
	if cfg.RedisURL != "" {
		opt, qerr := fibrjobs.RedisConnOpt(cfg.RedisURL)
		if qerr != nil {
			return qerr
		}
		queueClient = fibrjobs.NewClient(opt)
		cleanups = append(cleanups, func(ctx context.Context) error { return queueClient.Close() })
		asynqmonMount = &bootstrap.AsynqmonMount{
{{if not .Auth}}			// NOTE: the monitoring UI is unauthenticated. Add a Middleware guard (or regenerate with --auth) before exposing it publicly.
{{end}}			Handler: fibrjobs.MonitoringHandler(opt, cfg.AsynqmonPath),
			Path:    cfg.AsynqmonPath,
{{if .Auth}}			Middleware: []fiber.Handler{fibrauth.RequireAuth(cfg.JWTSecret)},
{{end}}		}
	} else {
		log.Println("queue disabled — set REDIS_URL to enable background jobs")
	}

{{end}}{{if .Mailer}}	mailSender, _ := fibrmailer.New(fibrmailer.SMTPConfig{
		Host:     cfg.SMTPHost,
		Port:     cfg.SMTPPort,
		Username: cfg.SMTPUsername,
		Password: cfg.SMTPPassword,
		From:     cfg.SMTPFrom,
	})
{{if .Queue}}	if queueClient != nil {
		mailSender = appjobs.NewQueueSender(queueClient)
	}
{{end}}{{end}}	// One Redis client shared by rate-limit + idempotency storage{{if .Realtime}}, the realtime backplane{{end}}{{if .Auth}}, and the auth token store{{end}}.
	var redisClient *redislib.Client
	if cfg.RedisURL != "" {
		if ropt, rerr := rediskit.ParseRedisOptions(cfg.RedisURL); rerr == nil {
			redisClient = redislib.NewClient(ropt)
			cleanups = append(cleanups, func(context.Context) error { return redisClient.Close() })
		}
	}
	opts := bootstrap.Options{
		DB:           db,
		AutoMigrate:  cfg.AutoMigrate || autoMigrate,
		Metrics:      cfg.MetricsEnabled,
		Tracing:      cfg.TracingEnabled,
		Cleanup:      cleanups,
{{if .Queue}}		Asynqmon:     asynqmonMount,
{{end}}		CORSOrigins:     cfg.CORSOrigins,
		RateLimit:       100,
		SecurityHeaders: true,
		Compression:     true,
		Idempotency:     true,
		HealthChecks:    []health.NamedCheck{health.PingBun(db)},
	}
	if redisClient != nil {
		opts.RateLimitStorage = rediskit.NewStorage(redisClient)
		opts.IdempotencyStorage = rediskit.NewStorage(redisClient, rediskit.WithPrefix("idempotency:"))
	}
	oapi := fibropenapi.New(fibropenapi.Info{Title: "{{.Name}}", Version: "0.1.0"})
	{{$router}}.RegisterDocs(oapi)
{{if .Auth}}	oapi.WithBearerAuth()
	{{$handler}}.RegisterAuthDocs(oapi)
{{end}}	opts.OpenAPI = oapi
{{if .I18n}}	i18nBundle := fibri18n.New(fibri18n.WithFallback("en"))
	if err := i18nBundle.LoadFS(locales.FS, "."); err != nil {
		return err
	}
	opts.I18n = i18nBundle
{{end}}	app := bootstrap.New(opts)

	// app.App is the embedded *fiber.App; app.Mount (below) is bootstrap.App's module-aware method.
	{{$router}}.Register(app.App)
{{if .Realtime}}	var rtRedis *rediskit.Redis
	if redisClient != nil {
		rtRedis = rediskit.New(redisClient)
	}
	{{$handler}}.RegisterRealtime(app.App, rtRedis)
{{end}}{{if .I18n}}	{{$handler}}.RegisterI18n(app.App)
{{end}}
{{if .Queue}}	if queueClient != nil {
		app.Post("/jobs/welcome", func(c fiber.Ctx) error {
			info, err := queueClient.Enqueue(c.Context(), appjobs.WelcomeType, appjobs.WelcomePayload{Email: "user@example.com"})
			if err != nil {
				return err
			}
			return c.JSON(fiber.Map{"enqueued": info.ID})
		})
	}
{{end}}{{if .Mailer}}	// demo smoke-test route; unauthenticated — remove or guard before exposing publicly.
	app.Post("/email/test", func(c fiber.Ctx) error {
		if err := mailSender.Send(c.Context(), fibrmailer.Message{To: []string{"someone@example.com"}, Subject: "Test email", Text: "It works.", HTML: "<p>It works.</p>"}); err != nil {
			return err
		}
		return c.JSON(fiber.Map{"sent": true})
	})
{{end}}{{if .Sample}}	if err := app.Mount({{$handler}}.NewUserModule(db)); err != nil {
		return err
	}
{{end}}{{if .Auth}}	var authStore fibrauth.TokenStore
	if redisClient != nil {
		authStore = fibrauth.NewRedisStore(rediskit.New(redisClient))
	} else {
		zlog.Warn().Msg("auth revocation using in-memory store — set REDIS_URL for production")
		authStore = fibrauth.NewMemoryStore()
	}
	if err := app.Mount({{$handler}}.NewAuthModule(db, cfg.JWTSecret, authStore{{if and .Team .Mailer}}, mailSender{{end}})); err != nil {
		return err
	}
{{end}}
	fmt.Printf("listening on :%s\n", cfg.Port)
	return app.Run(":" + cfg.Port)
}

func openDB(ctx context.Context) (*bun.DB, error) {
	cfg, err := config.Load()
	if err != nil {
		return nil, err
	}
	return {{$openDB}}(cfg.DatabaseURL)
}
